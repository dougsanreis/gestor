{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/learning-candidate.schema.json",
  "title": "LearningCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "learning_id",
    "tenant_id",
    "learning_type",
    "statement",
    "scope",
    "supporting_evidence_ids",
    "confidence",
    "risk_class",
    "status",
    "proposed_at",
    "expires_at"
  ],
  "properties": {
    "learning_id": {"type": "string", "pattern": "^lrn_[A-Za-z0-9_-]{8,}$"},
    "tenant_id": {"type": "string", "pattern": "^ten_[A-Za-z0-9_-]{8,}$"},
    "learning_type": {"type": "string", "enum": ["AUDIENCE", "COPY", "UX", "MODEL_ROUTE", "POLICY", "RUNBOOK", "FAILURE_PATTERN"]},
    "statement": {"type": "string", "minLength": 10, "maxLength": 2000},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {"type": "string", "enum": ["MISSION", "FUNNEL", "TENANT", "GLOBAL"]},
        "mission_id": {"type": ["string", "null"]},
        "funnel_id": {"type": ["string", "null"]}
      }
    },
    "supporting_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "contradicting_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_class": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "status": {"type": "string", "enum": ["CANDIDATE", "UNDER_REVIEW", "APPROVED", "REJECTED", "REVOKED", "EXPIRED"]},
    "governance_decision_id": {"type": ["string", "null"]},
    "proposed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"properties": {"level": {"enum": ["TENANT", "GLOBAL"]}}}}},
      "then": {"properties": {"status": {"not": {"const": "CANDIDATE"}}}}
    },
    {
      "if": {"properties": {"status": {"const": "APPROVED"}}},
      "then": {"required": ["governance_decision_id"]}
    }
  ]
}
