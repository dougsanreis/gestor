{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/governance-decision.schema.json",
  "title": "GovernanceDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "tenant_id",
    "subject_type",
    "subject_id",
    "policy_version",
    "risk_class",
    "decision",
    "reason_codes",
    "blocking_failures",
    "required_approvals",
    "evidence_ids",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "decision_id": {"type": "string", "pattern": "^gov_[A-Za-z0-9_-]{8,}$"},
    "tenant_id": {"type": "string", "pattern": "^ten_[A-Za-z0-9_-]{8,}$"},
    "subject_type": {"type": "string", "enum": ["artifact", "experiment", "release_candidate", "tool_call", "learning_candidate"]},
    "subject_id": {"type": "string", "minLength": 8},
    "policy_version": {"type": "string", "minLength": 1},
    "risk_class": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "decision": {"type": "string", "enum": ["APPROVE", "REQUIRE_APPROVAL", "REWORK", "REJECT", "PAUSE", "ROLLBACK"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}},
    "blocking_failures": {"type": "array", "items": {"type": "string"}},
    "required_approvals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "issued_by": {"type": "string", "default": "governor"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"risk_class": {"enum": ["HIGH", "CRITICAL"]}}},
      "then": {"properties": {"required_approvals": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"decision": {"const": "APPROVE"}}},
      "then": {"properties": {"blocking_failures": {"maxItems": 0}, "evidence_ids": {"minItems": 1}}}
    }
  ]
}
