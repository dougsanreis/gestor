PORT=8787
# Obrigatório. Mesmo valor do secret WORKER_API_KEY no app (mínimo 24 caracteres).
# Gere com: openssl rand -hex 32
WORKER_API_KEY=
# Só em máquina local: aceita rodar sem chave e sem allowlist. NUNCA em produção.
ALLOW_INSECURE_DEV=0

# Hosts permitidos (separados por vírgula; subdomínios incluídos).
# Download: padrão = host do SUPABASE_URL (signed URLs do bucket source-videos).
INPUT_ALLOWED_HOSTS=
# Callback: host público do app. O callback leva o WORKER_API_KEY, então é obrigatório.
CALLBACK_ALLOWED_HOSTS=

# Transcrição (obrigatória: o app reprova READY sem transcrição real).
# openai (padrão) | command (STT_COMMAND <audio> <saida.json>, ex.: scripts/transcribe_local.py) | none
STT_PROVIDER=openai
STT_COMMAND=
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=pt

# IA editorial — cascata Claude → Grok → Mistral → heurística local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
XAI_API_KEY=
XAI_MODEL=grok-2-latest
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Storage — Supabase (service role, só no worker).
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=rendered-videos
REPORTS_BUCKET=reports
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Servidor de teste (npm run dev:local): STORAGE_PROVIDER=local grava aqui e serve em /files.
LOCAL_STORAGE_DIR=.local-storage
PUBLIC_BASE_URL=http://localhost:8787

# Limites
MAX_JOB_DURATION_MS=900000
MAX_INPUT_BYTES=524288000
MAX_SOURCE_SECONDS=1200
MAX_QUEUE=20
DOWNLOAD_TIMEOUT_MS=300000
AI_TIMEOUT_MS=120000
STT_TIMEOUT_MS=300000
CALLBACK_TIMEOUT_MS=15000
FFMPEG_PATH=
FFPROBE_PATH=
CAPTION_FONT=Inter
