{
  "permissions": {
    "deny": [
      "Bash(rm *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(sudo rm *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(terraform destroy *)",
      "Write(.env*)",
      "Edit(.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_pre_tool.py"],
            "timeout": 10,
            "statusMessage": "Validando segurança da operação"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/post_change_check.py"],
            "timeout": 20,
            "statusMessage": "Verificando a alteração"
          }
        ]
      }
    ]
  }
}
