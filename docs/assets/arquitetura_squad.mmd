flowchart TB
  subgraph EXP[Plano de experiência]
    EDGE[Edge / CDN / WAF]
    WEB[Page Runtime]
    FORM[Quiz e formulários]
    COMMERCE[Checkout e agenda]
  end

  subgraph CTRL[Plano de controle]
    API[API / BFF]
    WORKFLOW[Workflow Engine]
    POLICY[Policy Engine]
    EXPERIMENT[Experiment Service]
    RELEASE[Release Controller]
    PRIVACY[Consent e Privacy]
  end

  subgraph INTEL[Plano de inteligência]
    ORCH[Agent Orchestrator]
    ROUTER[Model Router]
    AGENTS[Squad de agentes]
    EVAL[Evaluadores independentes]
    MEMORY[Knowledge e Memory]
    TOOLS[Tool Gateway]
  end

  subgraph EVID[Plano de evidência]
    EVENTS[Event Collector]
    JOURNEY[Profile e Journey State]
    METRICS[Metrics e Attribution]
    STORE[Evidence Store]
    OBS[Logs / Metrics / Traces]
  end

  EDGE --> WEB
  WEB --> API
  FORM --> API
  COMMERCE --> API
  API --> PRIVACY
  API --> EVENTS
  API --> EXPERIMENT
  EXPERIMENT --> WEB
  EVENTS --> JOURNEY
  EVENTS --> METRICS
  WORKFLOW --> ORCH
  POLICY --> WORKFLOW
  POLICY --> RELEASE
  ORCH --> ROUTER
  ORCH --> AGENTS
  AGENTS --> TOOLS
  AGENTS --> MEMORY
  AGENTS --> EVAL
  EVAL --> STORE
  METRICS --> WORKFLOW
  STORE --> RELEASE
  RELEASE --> WEB
  OBS -. monitora .- API
  OBS -. monitora .- WORKFLOW
  OBS -. monitora .- ORCH
  OBS -. monitora .- RELEASE

  classDef experience fill:#0B1220,stroke:#23C7D9,color:#FFFFFF,stroke-width:2px;
  classDef control fill:#111827,stroke:#A78BFA,color:#FFFFFF,stroke-width:2px;
  classDef intelligence fill:#15172A,stroke:#F59E0B,color:#FFFFFF,stroke-width:2px;
  classDef evidence fill:#0F1F1A,stroke:#34D399,color:#FFFFFF,stroke-width:2px;
  class EDGE,WEB,FORM,COMMERCE experience;
  class API,WORKFLOW,POLICY,EXPERIMENT,RELEASE,PRIVACY control;
  class ORCH,ROUTER,AGENTS,EVAL,MEMORY,TOOLS intelligence;
  class EVENTS,JOURNEY,METRICS,STORE,OBS evidence;
