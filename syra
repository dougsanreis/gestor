#!/usr/bin/env python3
"""SYRA Core entrypoint.

Runs from anywhere with no install, no virtualenv, and no dependencies:

    ./syra doctor
    ./syra selftest
    ./syra scan --root ~/Projects/SYRA

The directory containing this script is prepended to ``sys.path`` so the
adjacent ``syra_core`` package is importable regardless of the working
directory.
"""

from __future__ import annotations

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

if sys.version_info < (3, 8):
    sys.stderr.write(
        "PREFLIGHT_DECISION=FAIL\n"
        "REASON=PYTHON_TOO_OLD found={} need>=3.8\n".format(
            ".".join(str(part) for part in sys.version_info[:3])
        )
    )
    raise SystemExit(1)

from syra_core.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
